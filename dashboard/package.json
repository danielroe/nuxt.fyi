{
  "name": "nuxt-fyi-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv ../.env",
    "dev:ui-only": "NUXT_UI_ONLY=1 NODE_OPTIONS=\"${NODE_OPTIONS:-} --use-env-proxy\" nuxt dev --dotenv ../.env",
    "dev:fixtures": "NUXT_FIXTURES=1 nuxt dev --dotenv ../.env",
    "postinstall": "nuxt prepare",
    "preview": "node .output/server/index.mjs",
    "test:types": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/image": "^2.2.0",
    "defu": "^6.1.7",
    "nitro": "3.0.260903-beta",
    "nuxt": "npm:nuxt-nightly@5.0.0-2610221052-8c52432",
    "vue": "^3.5.0",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  }
}
